# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-2-preview
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
INGESTION_URL=http://localhost:8001

# Neo4j knowledge graph (GraphRAG). Password must be 8+ chars — Neo4j refuses to
# start otherwise. Set GRAPH_ENABLED=false to run pure vector RAG, as before.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword
NEO4J_DATABASE=neo4j
GRAPH_ENABLED=true
EXTRACT_MODEL=gemini-3.5-flash
# Extraction covers the whole document in successive overlapping windows.
EXTRACT_WINDOW_CHARS=60000
EXTRACT_WINDOW_OVERLAP=2000
EXTRACT_MAX_WINDOWS=40
# Chunks per embeddings request — the API caps inputs per call, so long documents
# must be embedded in batches rather than one request each.
EMBED_BATCH_SIZE=32

# Local LLM fallback — used automatically for chat/generation if Gemini errors
# (rate limit, 5xx, timeout). No key needed, Ollama runs locally.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma2:2b

# LangSmith tracing (optional) — leave blank to disable tracing entirely.
# Free account at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-platform
LANGSMITH_TRACING=true
